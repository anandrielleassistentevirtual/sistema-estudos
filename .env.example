# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key (sb_publishable_…) — pode ficar no navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Só para os scripts de importação (nunca vai para o navegador)
# Secret key (sb_secret_…) — NUNCA no navegador nem no GitHub
SUPABASE_SERVICE_ROLE_KEY=
# E-mail da sua conta no sistema (dono do conteúdo importado)
DONO_EMAIL=
