# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Só para os scripts de importação (nunca vai para o navegador)
SUPABASE_SERVICE_ROLE_KEY=
# E-mail da sua conta no sistema (dono do conteúdo importado)
DONO_EMAIL=
